# Gmail SMTP (OTP emails). Requires 2-Step Verification + an App Password:
# https://myaccount.google.com/apppasswords  (16 characters; spaces are ignored)
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Library Management <youraddress@gmail.com>

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
